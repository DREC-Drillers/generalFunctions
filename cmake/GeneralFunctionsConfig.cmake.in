@PACKAGE_INIT@

set(_general_functions_supported_components lexer files geometry tree)
set(_general_functions_requested_components "${GeneralFunctions_FIND_COMPONENTS}")

# Without COMPONENTS, expose every component installed in this package.
# An explicit request must not load unrelated components, especially C++ modules.
if(NOT _general_functions_requested_components)
    foreach(_component IN LISTS _general_functions_supported_components)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/GeneralFunctions-${_component}-targets.cmake")
            list(APPEND _general_functions_requested_components "${_component}")
        endif()
    endforeach()
endif()

foreach(_component IN LISTS _general_functions_requested_components)
    set(GeneralFunctions_${_component}_FOUND FALSE)

    if(NOT _component IN_LIST _general_functions_supported_components)
        string(APPEND GeneralFunctions_NOT_FOUND_MESSAGE
            "Unknown component '${_component}'. ")
        continue()
    endif()

    set(_targets_file
        "${CMAKE_CURRENT_LIST_DIR}/GeneralFunctions-${_component}-targets.cmake")

    if(NOT EXISTS "${_targets_file}")
        string(APPEND GeneralFunctions_NOT_FOUND_MESSAGE
            "Component '${_component}' is not installed. ")
        continue()
    endif()

    if(_component STREQUAL "geometry" AND CMAKE_VERSION VERSION_LESS 3.28)
        string(APPEND GeneralFunctions_NOT_FOUND_MESSAGE
            "The geometry component requires CMake >= 3.28. ")
        continue()
    endif()

    include("${_targets_file}")
    set(GeneralFunctions_${_component}_FOUND TRUE)
endforeach()

check_required_components(GeneralFunctions)

unset(_general_functions_supported_components)
unset(_general_functions_requested_components)
unset(_component)
unset(_targets_file)

